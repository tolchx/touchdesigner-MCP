    # GET /get_hints
    # =========================================================================

    def _handle_get_hints(self, node_type: str, response: dict) -> dict:
        """Get operator hints (delegates to knowledge base)."""
        result = {
            "success": True,
            "operatorType": node_type,
            "hint": f"Use get_param_help for parameter details on '{node_type}'."
        }
