  "troubleshooting": [
    {
      "problem": "File not writing",
      "solution": "Check write permissions and valid path with extension"
    },
    {
      "problem": "Missing attributes",
      "solution": "Some formats require specific attributes (SPZ needs P, Color, Scale, Rot)"
    },
    {
      "problem": "Sequence not numbering",
      "solution": "Enable Unique Suffix and check Leading Zeros"
    },
    {
      "problem": "Large files",
      "solution": "Reduce Max Active Saves or use simpler formats (PLY over OBJ)"
    }
  ],
  "description": "Writes POP contents to file types including OBJ (normals, UV, color), SPZ (Gaussian splatting), E57 (point clouds), PLY (arbitrary attributes), EXR (arbitrary attributes). Supports single file or file sequence recording."
